DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/karigar_ledger
DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@localhost:5432/karigar_test
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_EXPIRE_MINUTES=1440

# Groq Cloud API Configuration (Required for AI Vision Scale/Karat reader and Craft Loss Explanations)
# Model names must be verified in the Groq console (https://console.groq.com/docs/models)
# Recommended vision models: llama-3.2-11b-vision-preview or llama-3.2-90b-vision-preview
# Recommended text models: llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000
SEED_CLERK_PASSWORD=Clerk@123
SEED_FINANCE_PASSWORD=Finance@123
